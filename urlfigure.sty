
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{urlfigure}[2026/10/22 v1.3 URL figures with caching]

\RequirePackage{float}
\RequirePackage{graphicx}
\RequirePackage{shellesc}
\RequirePackage{environ}

\newcounter{urlimagecounter}

\newcommand{\urlimage}[2][0.5\textwidth]{%
  \stepcounter{urlimagecounter}%
  \edef\urlfigstem{urlimage-\arabic{urlimagecounter}}%
  \ShellEscape{powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$p = kpsewhich -format=tex urlfigure-fetch-v13.ps1; if (-not $p) { exit 1 }; & $p -Url '#2' -Stem '\urlfigstem'"}%
  \IfFileExists{\urlfigstem.tex}{%
    \input{\urlfigstem.tex}%
    \includegraphics[width=#1]{\urlfigimagefile}%
  }{%
    \PackageError{urlfigure}
      {Image download failed for \urlfigstem}
      {Check URL, internet, helper installation and shell-escape.}%
  }%
}

\NewEnviron{urlfigure}{%
  \begin{figure}[H]%
    \centering
    \let\urlfigoriginalcaption\caption
    \let\urlfigoriginallabel\label
    \def\urlfigcaptiontext{}%
    \def\urlfiglabeltext{}%
    \renewcommand{\caption}[1]{%
      \def\urlfigcaptiontext{##1}%
    }%
    \renewcommand{\label}[1]{%
      \def\urlfiglabeltext{##1}%
    }%
    \BODY
    \let\caption\urlfigoriginalcaption
    \let\label\urlfigoriginallabel
    \caption{\urlfigcaptiontext}%
    \ifx\urlfiglabeltext\empty
    \else
      \label{\urlfiglabeltext}%
    \fi
  \end{figure}%
}
