\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{code}[2026/10/22 v1.1 Code listings with line numbers]
\RequirePackage{listings}
\RequirePackage{xcolor}

\definecolor{codebackground}{RGB}{245,247,250}
\definecolor{codekeyword}{RGB}{25,70,155}
\definecolor{codecomment}{RGB}{25,120,75}

\lstdefinestyle{codeStyle}{
  basicstyle=\ttfamily\small,
  backgroundcolor=\color{codebackground},
  keywordstyle=\color{codekeyword},
  commentstyle=\color{codecomment},
  numbers=left,
  numberstyle=\tiny\color{gray},
  numbersep=7pt,
  stepnumber=1,
  firstnumber=1,
  frame=single,
  rulecolor=\color{gray!35},
  breaklines=true,
  breakatwhitespace=false,
  columns=fullflexible,
  keepspaces=true,
  showstringspaces=false,
  tabsize=4
}

\lstnewenvironment{code}[1][]{%
  \lstset{style=codeStyle,#1}%
}{}
\endinput
